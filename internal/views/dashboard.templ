package views

import "time"
import "strconv"

templ DashboardPage(name string, maskedEmail string, createdAt time.Time, activeSessions int) {
    <!DOCTYPE html>
    <html lang="en">
    @Head(SEOMeta{
        Title: "Dashboard - GoApp",
        Description: "Your dashboard",
    })
    <body class="min-h-screen bg-gray-50 flex flex-col">
        @Header("dashboard", name)

        <main class="flex-1">
            <div class="max-w-4xl mx-auto px-8 py-12 space-y-6">

                <h1 class="text-3xl font-bold">Welcome, { name }!</h1>

                <!-- Account Info Card -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                    <h2 class="text-lg font-semibold text-gray-800 mb-4">Account Info</h2>
                    <div class="space-y-3">
                        <div class="flex items-center gap-3">
                            <span class="text-sm text-gray-500 w-32">Email</span>
                            <span class="text-sm text-gray-800">{ maskedEmail }</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-sm text-gray-500 w-32">Member since</span>
                            <span class="text-sm text-gray-800">{ createdAt.Format("January 2006") }</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-sm text-gray-500 w-32">Active devices</span>
                            <span class="text-sm text-gray-800">{ strconv.Itoa(activeSessions) }</span>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                    <h2 class="text-lg font-semibold text-gray-800 mb-4">Security</h2>
                    <a href="/logout" class="inline-block px-4 py-2 bg-red-50 text-red-600 border border-red-200 rounded-lg text-sm hover:bg-red-100 transition-colors">
                        Sign Out
                    </a>
                </div>

            </div>
        </main>
        @Footer()
    </body>
    </html>
}