package views

templ HomePage() {
	<!DOCTYPE html>
	<html lang="en">
	@Head(SEOMeta{
		Title: "Home - GoApp",
		Description: "A high performance web app built with Go, Templ, and HTMX",
		Keywords: "go, golang, htmx, templ, web app",
		CanonicalURL: "https://yourdomain.com/",
		OGImage: "https://yourdomain.com/public/og-image.png",
	})
	<body class="min-h-screen bg-gray-50 flex flex-col">
		@Header("home")

		<main class="flex-1">
			<div class="max-w-4xl mx-auto px-8 py-12">
				<div class="text-center mb-12">
					<h1 class="text-5xl font-bold mb-4">Welcome to GoApp</h1>
					<p class="text-xl text-gray-600">Server-Side Rendered with Go and Templ</p>
				</div>
				
				<div class="grid gap-6 md:grid-cols-2 mb-12">
					<div class="bg-white p-6 rounded-lg shadow-md">
						<h2 class="text-2xl font-semibold mb-3">Fast & Efficient</h2>
						<p class="text-gray-700">Built with Go for high performance and low resource usage.</p>
					</div>
					
					<div class="bg-white p-6 rounded-lg shadow-md">
						<h2 class="text-2xl font-semibold mb-3">Type-Safe Templates</h2>
						<p class="text-gray-700">Using templ for type-safe, compiled HTML templates.</p>
					</div>
					
					<div class="bg-white p-6 rounded-lg shadow-md">
						<h2 class="text-2xl font-semibold mb-3">HTMX Integration</h2>
						<p class="text-gray-700">Dynamic interactions without complex JavaScript frameworks.</p>
					</div>
					
					<div class="bg-white p-6 rounded-lg shadow-md">
						<h2 class="text-2xl font-semibold mb-3">Tailwind CSS</h2>
						<p class="text-gray-700">Beautiful, responsive design with utility-first CSS.</p>
					</div>
				</div>
				
				<div class="text-center space-x-4">
					<a href="/register" class="inline-block bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition-colors text-lg font-semibold">
						Get Started
					</a>
					<a href="/contact" class="inline-block bg-white text-blue-600 border border-blue-600 px-8 py-3 rounded-lg hover:bg-blue-50 transition-colors text-lg font-semibold">
						Get in Touch
					</a>
				</div>
			</div>
		</main>

		@Footer()
	</body>
	</html>
}