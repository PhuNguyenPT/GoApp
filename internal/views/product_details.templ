package views

import (
    "fmt"
    "GoApp/internal/database"
)

templ ProductDetailPage(userName string, p database.GetProductByIDRow, lang string) {
    <!DOCTYPE html>
    <html lang={ lang }>
    @Head(SEOMeta{
        Title:       p.Name.String,
        Description: fmt.Sprintf("%s - %s", p.Brand.String, p.Category.String),
    })
    <body class="min-h-screen bg-gray-50 flex flex-col">
        @Header("products", userName, lang)
        <main class="flex-1 max-w-4xl mx-auto px-8 py-10 w-full">
            <a href="/products" class="text-sm text-blue-600 hover:underline mb-6 inline-block">← { T(lang).Products }</a>

            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
                    <!-- Image -->
                    <div class="aspect-square bg-gray-100 overflow-hidden">
                        if p.Images.Valid {
                            <div class="flex w-full h-full overflow-x-auto snap-x snap-mandatory scroll-smooth">
                                for _, img := range extractAllImages(p.Images.RawMessage) {
                                    <div class="w-full h-full shrink-0 snap-start">
                                        <img
                                            src={ img }
                                            alt={ p.Name.String }
                                            class="w-full h-full object-cover"
                                            onerror="this.style.display='none'"
                                        />
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Info -->
                    <div class="p-8 flex flex-col gap-4">
                        if p.Brand.Valid {
                            <span class="text-xs text-blue-600 font-medium uppercase tracking-wide">{ p.Brand.String }</span>
                        }
                        if p.Name.Valid {
                            <h1 class="text-2xl font-bold text-gray-900">{ p.Name.String }</h1>
                        }
                        if p.Category.Valid {
                            <span class="text-sm text-gray-500">{ p.Category.String }</span>
                        }

                        <div class="flex items-center gap-3 mt-2">
                            if p.Price.Valid {
                                <span class="text-2xl font-bold text-gray-900">{ formatPrice(p.Price.String) }</span>
                            }
                            if p.DiscountPercent.Valid && p.DiscountPercent.Int32 > 0 {
                                <span class="text-sm bg-red-100 text-red-600 px-2 py-0.5 rounded font-medium">
                                    -{ fmt.Sprintf("%d%%", p.DiscountPercent.Int32) }
                                </span>
                            }
                        </div>

                        if p.OriginalPrice.Valid && p.OriginalPrice.String != "" {
                            <span class="text-sm text-gray-400 line-through">{ formatPrice(p.OriginalPrice.String) }</span>
                        }

                        if p.Rating.Valid {
                            <span class="text-sm text-yellow-500">★ { p.Rating.String }</span>
                        }

                        if p.Source.Valid {
                            <div class="mt-auto pt-4 border-t border-gray-100">
                                <a href={ templ.SafeURL(p.Url) } target="_blank" rel="noopener noreferrer"
                                   class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors font-semibold text-sm">
                                    { T(lang).ViewOnStore }
                                </a>
                                <p class="text-xs text-gray-400 mt-2">{ T(lang).Source }: { p.Source.String }</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </main>
        @Footer(lang)
    </body>
    </html>
}