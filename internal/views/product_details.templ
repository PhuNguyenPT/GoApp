package views

import (
	"GoApp/internal/database"
	"fmt"
)

templ ProductDetailPage(userName string, p database.Product, lang string) {
	<!DOCTYPE html>
	<html lang={ lang }>
		@Head(SEOMeta{
			Title:       p.Name.String,
			Description: fmt.Sprintf("%s - %s", p.Brand.String, p.Category.String),
		})
		<body class="min-h-screen bg-gray-50 flex flex-col">
			@Header("products", userName, lang)
			<main class="flex-1 max-w-7xl mx-auto px-8 py-10 w-full">
				<a href="/products" class="text-sm text-blue-600 hover:underline mb-6 inline-block">← { T(lang).Products }</a>
				<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
					<div class="flex flex-col md:flex-row">
						<!-- Image -->
						<div class="md:w-3/5 bg-white flex items-center justify-center">
							if p.Images.Valid {
								<div
									class="relative cursor-pointer w-full h-64 md:h-[500px]"
									id="lightbox-trigger"
									data-images={ string(p.Images.RawMessage) }
								>
									<img
										src={ extractFirstImage(p.Images.RawMessage) }
										alt={ p.Name.String }
										class="w-full h-full object-contain"
										onerror="this.style.display='none'"
									/>
									if len(extractAllImages(p.Images.RawMessage)) > 1 {
										<span class="absolute bottom-2 right-2 bg-black/50 text-white text-xs px-2 py-1 rounded-full">
											{ fmt.Sprintf("1 / %d", len(extractAllImages(p.Images.RawMessage))) }
										</span>
									}
								</div>
								<!-- Lightbox -->
								<div id="lightbox" class="fixed inset-0 bg-black/80 z-50 hidden items-center justify-center">
									<button id="prev-btn" class="absolute left-4 text-white text-4xl px-4 py-2 hover:text-gray-300">‹</button>
									<img id="lightbox-img" src="" alt="" class="max-h-screen max-w-screen-md object-contain p-4"/>
									<button id="next-btn" class="absolute right-4 text-white text-4xl px-4 py-2 hover:text-gray-300">›</button>
									<span id="lightbox-counter" class="absolute bottom-4 text-white text-sm"></span>
									<button id="close-btn" class="absolute top-4 right-4 text-white text-2xl hover:text-gray-300">✕</button>
								</div>
							}
						</div>
						<!-- Info -->
						<div class="md:w-2/5 p-8 flex flex-col gap-4 border-t md:border-t-0 md:border-l border-gray-200">
							if p.Brand.Valid {
								<span class="text-xs text-blue-600 font-medium uppercase tracking-wide">{ p.Brand.String }</span>
							}
							if p.Name.Valid {
								<h1 class="text-2xl font-bold text-gray-900">{ p.Name.String }</h1>
							}
							if p.Category.Valid {
								<span class="text-sm text-gray-500">{ p.Category.String }</span>
							}
							if p.Sku.Valid && p.Sku.String != "" {
								<span class="text-xs text-gray-400">SKU: { p.Sku.String }</span>
							}
							<div class="flex items-center gap-3 mt-2">
								if p.Price.Valid {
									<span class="text-2xl font-bold text-gray-900">{ formatPrice(p.Price.String) }</span>
								}
								if p.DiscountPercent.Valid && p.DiscountPercent.Int32 > 0 {
									<span class="text-sm bg-red-100 text-red-600 px-2 py-0.5 rounded font-medium">
										-{ fmt.Sprintf("%d%%", p.DiscountPercent.Int32) }
									</span>
								}
							</div>
							if p.OriginalPrice.Valid && p.OriginalPrice.String != "" {
								<span class="text-sm text-gray-400 line-through">{ formatPrice(p.OriginalPrice.String) }</span>
							}
							if p.Rating.Valid {
								<span class="text-sm text-yellow-500">
									★ { p.Rating.String }
									if p.ReviewCount.Valid && p.ReviewCount.Int32 > 0 {
										<span class="text-gray-400">({ fmt.Sprintf("%d", p.ReviewCount.Int32) } { T(lang).Reviews })</span>
									}
								</span>
							}
							if p.InStock.Valid {
								if p.InStock.Bool {
									<span class="text-sm text-green-600 font-medium">✓ { T(lang).InStock }</span>
								} else {
									<span class="text-sm text-red-500 font-medium">✗ { T(lang).OutOfStock }</span>
								}
							}
							if p.Source.Valid {
								<div class="mt-auto pt-4 border-t border-gray-100">
									<a
										href={ templ.SafeURL(p.Url) }
										target="_blank"
										rel="noopener noreferrer"
										class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors font-semibold text-sm"
									>
										{ T(lang).ViewOnStore }
									</a>
									<p class="text-xs text-gray-400 mt-2">{ T(lang).Source }: { p.Source.String }</p>
								</div>
							}
						</div>
					</div>
				</div>
				<!-- Description + Specs Tabs -->
				if (p.Description.Valid && p.Description.String != "") || p.Specs.Valid {
					<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mt-6">
						<!-- Tab Headers -->
						<div class="flex border-b border-gray-200">
							if p.Description.Valid && p.Description.String != "" {
								<button
									id="tab-desc"
									class="px-8 py-4 text-sm font-semibold text-blue-600 border-b-2 border-blue-600 bg-white"
									data-tab="desc"
								>{ T(lang).Description }</button>
							}
							if p.Specs.Valid {
								if specs := extractSpecsOrdered(p.Specs.RawMessage); len(specs) > 0 {
									<button
										id="tab-specs"
										class="px-8 py-4 text-sm font-semibold text-gray-500 hover:text-gray-700 border-b-2 border-transparent"
										data-tab="specs"
									>{ T(lang).Specifications }</button>
								}
							}
						</div>
						<!-- Description Panel -->
						if p.Description.Valid && p.Description.String != "" {
							<div id="panel-desc" class="px-8 py-6">
								<div id="desc-wrapper" class="relative overflow-hidden max-h-40 transition-[max-height] duration-300 ease-in-out">
									<p class="text-sm text-gray-700 leading-relaxed whitespace-pre-line">{ p.Description.String }</p>
									<div id="desc-fade" class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-white via-white/80 to-transparent pointer-events-none"></div>
								</div>
								<div class="flex justify-center mt-2">
									<button
										id="desc-toggle"
										class="text-sm text-blue-600 hover:underline font-medium"
										data-more={ T(lang).ShowMore }
										data-less={ T(lang).ShowLess }
									>{ T(lang).ShowMore }</button>
								</div>
							</div>
						}
						<!-- Specs Panel -->
						if p.Specs.Valid {
							if specs := extractSpecsOrdered(p.Specs.RawMessage); len(specs) > 0 {
								<div id="panel-specs" class="hidden">
									<div class="grid grid-cols-1">
										for i, spec := range specs {
											<div class={ "flex py-3 px-8 gap-4", templ.KV("bg-gray-100", i % 2 != 0) }>
												<span class="w-1/3 text-sm text-gray-500 font-medium shrink-0">{ spec[0] }</span>
												<span class="text-sm text-gray-800">{ spec[1] }</span>
											</div>
										}
									</div>
								</div>
							}
						}
					</div>
				}
			</main>
			<script src="/public/product-detail.min.js"></script>
			@Footer(lang)
		</body>
	</html>
}
