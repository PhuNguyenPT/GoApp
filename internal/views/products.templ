package views

import (
    "fmt"
    "database/sql"
    "GoApp/internal/database"
)

type ProductsPageData struct {
    Sources          []sql.NullString
    Categories       []sql.NullString
    Products         []database.Product
    SelectedSource   string
    SelectedCategory string
    Page             int
    TotalPages       int
    TotalCount       int64
}

templ ProductsPage(userName string, data ProductsPageData, lang string) {
    <!DOCTYPE html>
    <html lang={ lang }>
    @Head(SEOMeta{
        Title:       T(lang).ProductsTitle,
        Description: T(lang).ProductsDescription,
    })
    <body class="min-h-screen bg-gray-50 flex flex-col">
        @Header("products", userName, lang)
        <main class="flex-1 max-w-6xl mx-auto px-8 py-10 w-full">
            <h1 class="text-3xl font-bold mb-6"> { T(lang).Products } </h1>
            <form method="GET" action="/products" class="flex flex-wrap gap-4 mb-8">
                <select name="source" class="border rounded-lg px-3 py-2 text-sm"
                    hx-get="/products"
                    hx-target="#product-results"
                    hx-include="[name='source'],[name='category']"
                    hx-vals='{"trigger": "source"}'
                    hx-push-url="true">
                    <option value="">{ T(lang).AllSources }</option>
                    for _, s := range data.Sources {
                        if s.Valid {
                            <option value={ s.String } selected?={ data.SelectedSource == s.String }>
                                { s.String }
                            </option>
                        }
                    }
                </select>
                <select id="category-select" name="category" class="border rounded-lg px-3 py-2 text-sm w-72"
                    hx-get="/products"
                    hx-target="#product-results"
                    hx-include="[name='source'],[name='category']"
                    hx-push-url="true">
                    <option value="">{ T(lang).AllCategories }</option>
                    for _, c := range data.Categories {
                        if c.Valid {
                            <option value={ c.String } selected?={ data.SelectedCategory == c.String }>
                                { c.String }
                            </option>
                        }
                    }
                </select>
            </form>
            <div id="product-results">
                @ProductGrid(data, lang)
            </div>
        </main>
        @Footer(lang)
    </body>
    </html>
}

templ ProductGrid(data ProductsPageData, lang string) {
    if len(data.Products) == 0 {
        <p class="text-gray-500">{ T(lang).NoProducts }</p>
    } else {
        <p class="text-sm text-gray-500 mb-4">{ fmt.Sprintf("%d %s", data.TotalCount, T(lang).ProductsFound) }</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
            for _, p := range data.Products {
                @ProductCard(p)
            }
        </div>
        if data.TotalPages > 1 {
            <div class="flex gap-1 mt-8 justify-center items-center flex-wrap">
                if data.Page > 1 {
                    <a href={ templ.SafeURL(fmt.Sprintf("/products?source=%s&category=%s&page=%d", data.SelectedSource, data.SelectedCategory, data.Page-1)) }
                    class="px-3 py-2 rounded-lg border hover:bg-gray-100 text-sm">←</a>
                }

                for _, p := range paginationPages(data.Page, data.TotalPages) {
                    if p == 0 {
                        <span class="px-2 py-2 text-sm text-gray-400">...</span>
                    } else if p == data.Page {
                        <span class="px-3 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold">{ fmt.Sprintf("%d", p) }</span>
                    } else {
                        <a href={ templ.SafeURL(fmt.Sprintf("/products?source=%s&category=%s&page=%d", data.SelectedSource, data.SelectedCategory, p)) }
                        class="px-3 py-2 rounded-lg border hover:bg-gray-100 text-sm">{ fmt.Sprintf("%d", p) }</a>
                    }
                }

                if data.Page < data.TotalPages {
                    <a href={ templ.SafeURL(fmt.Sprintf("/products?source=%s&category=%s&page=%d", data.SelectedSource, data.SelectedCategory, data.Page+1)) }
                    class="px-3 py-2 rounded-lg border hover:bg-gray-100 text-sm">→</a>
                }

                <span class="w-full text-center text-sm text-gray-500 mt-1">
                    { fmt.Sprintf("%s %d %s %d", T(lang).Page, data.Page, T(lang).Of, data.TotalPages) }
                </span>
            </div>
        }
    }
}

templ ProductCard(p database.Product) {
    <a href={ templ.SafeURL(fmt.Sprintf("/products/%s", p.ID.String())) }
       class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col">
        <div class="aspect-square bg-gray-100 overflow-hidden">
            if p.Images.Valid {
                <img
                    src={ extractFirstImage(p.Images.RawMessage) }
                    alt={ p.Name.String }
                    class="w-full h-full object-contain p-4"
                    loading="lazy"
                    onerror="this.style.display='none'"
                />
            }
        </div>
        <div class="p-4 flex flex-col flex-1">
            if p.Brand.Valid {
                <span class="text-xs text-blue-600 font-medium uppercase tracking-wide mb-1">{ p.Brand.String }</span>
            }
            <h3 class="text-sm font-semibold text-gray-800 line-clamp-2 flex-1 mb-2">
                if p.Name.Valid {
                    { p.Name.String }
                }
            </h3>
            <div class="flex items-center justify-between mt-auto">
                <div>
                    if p.Price.Valid {
                        <span class="text-base font-bold text-gray-900">{ formatPrice(p.Price.String) }</span>
                    }
                    if p.DiscountPercent.Valid && p.DiscountPercent.Int32 > 0 {
                        <span class="ml-2 text-xs bg-red-100 text-red-600 px-1.5 py-0.5 rounded font-medium">
                            -{ fmt.Sprintf("%d%%", p.DiscountPercent.Int32) }
                        </span>
                    }
                </div>
                if p.Rating.Valid {
                    <span class="text-xs text-yellow-500">★ { p.Rating.String }</span>
                }
            </div>
            if p.Source.Valid {
                <span class="mt-2 text-xs text-gray-400">{ p.Source.String }</span>
            }
        </div>
    </a>
}

templ CategorySelectOOB(categories []sql.NullString, selectedCategory string, lang string) {
    <select id="category-select" name="category" class="border rounded-lg px-3 py-2 text-sm w-72"
        hx-get="/products"
        hx-target="#product-results"
        hx-include="[name='source'],[name='category']"
        hx-push-url="true"
        hx-swap-oob="true">
        <option value="">{ T(lang).AllCategories }</option>
        for _, c := range categories {
            if c.Valid {
                <option value={ c.String } selected?={ selectedCategory == c.String }>
                    { c.String }
                </option>
            }
        }
    </select>
}