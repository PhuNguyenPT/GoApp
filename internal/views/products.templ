package views

import (
	"GoApp/internal/database"
	"database/sql"
	"fmt"
)

type ProductsPageData struct {
	Sources             []sql.NullString
	Categories          []sql.NullString
	Subcategories       []sql.NullString
	Products            []database.GetProductSummariesRow
	SelectedSource      string
	SelectedCategory    string
	SelectedSubcategory string
	Page                int
	TotalPages          int
	TotalCount          int64
}

templ ProductsPage(userName string, data ProductsPageData, lang string) {
	<!DOCTYPE html>
	<html lang={ lang }>
		@Head(SEOMeta{
			Title:       T(lang).ProductsTitle,
			Description: T(lang).ProductsDescription,
		})
		<body class="min-h-screen bg-gray-50 flex flex-col">
			@Header("products", userName, lang)
			<main class="flex-1 max-w-7xl mx-auto px-4 py-8 w-full">
				<div class="flex gap-6">
					<!-- Side Filter Panel -->
					<aside class="w-64 flex-shrink-0">
						@FilterPanel(data, lang)
					</aside>
					<!-- Main Content -->
					<div class="flex-1 min-w-0">
						<div class="flex items-center justify-between mb-6">
							<h1 class="text-2xl font-bold">{ T(lang).Products }</h1>
							<!-- Mobile filter toggle -->
							<button
								class="lg:hidden flex items-center gap-2 text-sm border rounded-lg px-3 py-2 hover:bg-gray-100"
								onclick="document.getElementById('mobile-filter').classList.toggle('hidden')"
							>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h18M6 12h12M9 20h6"></path>
								</svg>
								{ T(lang).Filters }
							</button>
						</div>
						<!-- Active filter chips -->
						<div id="active-chips">
							if data.SelectedSource != "" || data.SelectedCategory != "" || data.SelectedSubcategory != "" {
								<div class="flex flex-wrap gap-2 mb-4">
									if data.SelectedSource != "" {
										<span class="inline-flex items-center gap-1 text-xs bg-blue-100 text-blue-700 rounded-full px-3 py-1 font-medium">
											{ data.SelectedSource }
											<a
												href={ templ.SafeURL(fmt.Sprintf("/products?category=%s&subcategory=%s", data.SelectedCategory, data.SelectedSubcategory)) }
												class="hover:text-blue-900 ml-1"
											>
												✕
											</a>
										</span>
									}
									if data.SelectedCategory != "" {
										<span class="inline-flex items-center gap-1 text-xs bg-blue-100 text-blue-700 rounded-full px-3 py-1 font-medium">
											{ data.SelectedCategory }
											<a
												href={ templ.SafeURL(fmt.Sprintf("/products?source=%s&subcategory=%s", data.SelectedSource, data.SelectedSubcategory)) }
												class="hover:text-blue-900 ml-1"
											>
												✕
											</a>
										</span>
									}
									if data.SelectedSubcategory != "" {
										<span class="inline-flex items-center gap-1 text-xs bg-blue-100 text-blue-700 rounded-full px-3 py-1 font-medium">
											{ data.SelectedSubcategory }
											<a
												href={ templ.SafeURL(fmt.Sprintf("/products?source=%s&category=%s", data.SelectedSource, data.SelectedCategory)) }
												class="hover:text-blue-900 ml-1"
											>
												✕
											</a>
										</span>
									}
									<a
										href="/products"
										class="text-xs text-gray-500 hover:text-gray-700 underline self-center"
									>
										{ T(lang).ClearAll }
									</a>
								</div>
							}
						</div>
						<div id="product-results">
							@ProductGrid(data, lang)
						</div>
					</div>
				</div>
			</main>
			@Footer(lang)
		</body>
	</html>
}

templ FilterPanel(data ProductsPageData, lang string) {
	<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden sticky top-4">
		<div id="filter-header" class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
			<span class="font-semibold text-sm text-gray-700">{ T(lang).Filters }</span>
			if data.SelectedSource != "" || data.SelectedCategory != "" || data.SelectedSubcategory != "" {
				<a
					href="/products"
					class="text-xs text-blue-600 hover:text-blue-800"
				>
					{ T(lang).ClearAll }
				</a>
			}
		</div>
		<!-- Source Filter -->
		<div id="source-filter" class="px-4 py-4 border-b border-gray-100">
			<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">{ T(lang).Source }</h3>
			<ul class="space-y-1">
				<li>
					<a
						href="/products"
						hx-get="/products"
						hx-target="#product-results"
						hx-vals='{"source": "", "category": "", "subcategory": "", "trigger": "source"}'
						hx-push-url="true"
						class={ "flex items-center gap-2 text-sm rounded-lg px-2 py-1.5 w-full transition-colors " + sourceItemClass("", data.SelectedSource) }
					>
						<span class="flex-1">{ T(lang).AllSources }</span>
					</a>
				</li>
				for _, s := range data.Sources {
					if s.Valid {
						<li>
							<a
								href={ templ.SafeURL(fmt.Sprintf("/products?source=%s", s.String)) }
								hx-get="/products"
								hx-target="#product-results"
								hx-vals={ fmt.Sprintf(`{"source": "%s", "category": "", "subcategory": "", "trigger": "source"}`, s.String) }
								hx-push-url="true"
								class={ "flex items-center gap-2 text-sm rounded-lg px-2 py-1.5 w-full transition-colors " + sourceItemClass(s.String, data.SelectedSource) }
							>
								<span class="flex-1">{ s.String }</span>
							</a>
						</li>
					}
				}
			</ul>
		</div>
		<!-- Category Filter -->
		if len(data.Categories) > 0 {
			<div id="category-filter" class="px-4 py-4 border-b border-gray-100">
				<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">{ T(lang).Category }</h3>
				<ul class="space-y-1 max-h-72 overflow-y-auto">
					<li>
						<a
							href={ templ.SafeURL(fmt.Sprintf("/products?source=%s", data.SelectedSource)) }
							hx-get="/products"
							hx-target="#product-results"
							hx-vals={ fmt.Sprintf(`{"source": "%s", "category": "", "subcategory": "", "trigger": "category"}`, data.SelectedSource) }
							hx-push-url="true"
							class={ "flex items-center gap-2 text-sm rounded-lg px-2 py-1.5 w-full transition-colors " + categoryItemClass("", data.SelectedCategory) }
						>
							<span class="flex-1">{ T(lang).AllCategories }</span>
						</a>
					</li>
					for _, cat := range data.Categories {
						if cat.Valid {
							<li>
								<a
									href={ templ.SafeURL(fmt.Sprintf("/products?source=%s&category=%s", data.SelectedSource, cat.String)) }
									hx-get="/products"
									hx-target="#product-results"
									hx-vals={ fmt.Sprintf(`{"source": "%s", "category": "%s", "subcategory": "", "trigger": "category"}`, data.SelectedSource, cat.String) }
									hx-push-url="true"
									class={ "flex items-center gap-2 text-sm rounded-lg px-2 py-1.5 w-full transition-colors " + categoryItemClass(cat.String, data.SelectedCategory) }
								>
									<span class="flex-1 leading-tight">{ cat.String }</span>
								</a>
							</li>
						}
					}
				</ul>
			</div>
		}
		<!-- Subcategory Filter -->
		if data.SelectedCategory != "" && len(data.Subcategories) > 0 {
			<div id="subcategory-filter" class="px-4 py-4">
				<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">{ T(lang).Brand }</h3>
				<ul class="space-y-1 max-h-60 overflow-y-auto">
					<li>
						<a
							href={ templ.SafeURL(fmt.Sprintf("/products?source=%s&category=%s", data.SelectedSource, data.SelectedCategory)) }
							hx-get="/products"
							hx-target="#product-results"
							hx-vals={ fmt.Sprintf(`{"source": "%s", "category": "%s", "subcategory": ""}`, data.SelectedSource, data.SelectedCategory) }
							hx-push-url="true"
							class={ "flex items-center gap-2 text-sm rounded-lg px-2 py-1.5 w-full transition-colors " + categoryItemClass("", data.SelectedSubcategory) }
						>
							<span class="flex-1">{ T(lang).AllCategories }</span>
						</a>
					</li>
					for _, sub := range data.Subcategories {
						if sub.Valid {
							<li>
								<a
									href={ templ.SafeURL(fmt.Sprintf("/products?source=%s&category=%s&subcategory=%s", data.SelectedSource, data.SelectedCategory, sub.String)) }
									hx-get="/products"
									hx-target="#product-results"
									hx-vals={ fmt.Sprintf(`{"source": "%s", "category": "%s", "subcategory": "%s"}`, data.SelectedSource, data.SelectedCategory, sub.String) }
									hx-push-url="true"
									class={ "flex items-center gap-2 text-sm rounded-lg px-2 py-1.5 w-full transition-colors " + categoryItemClass(sub.String, data.SelectedSubcategory) }
								>
									<span class="flex-1 leading-tight">{ sub.String }</span>
								</a>
							</li>
						}
					}
				</ul>
			</div>
		} else {
			<div id="subcategory-filter"></div>
		}
	</div>
}

templ CategoryFilterOOB(categories []sql.NullString, selectedSource string, selectedCategory string, lang string) {
	<div id="category-filter" class="px-4 py-4 border-b border-gray-100" hx-swap-oob="true">
		if len(categories) > 0 {
			<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">{ T(lang).Category }</h3>
			<ul class="space-y-1 max-h-72 overflow-y-auto">
				<li>
					<a
						href={ templ.SafeURL(fmt.Sprintf("/products?source=%s", selectedSource)) }
						hx-get="/products"
						hx-target="#product-results"
						hx-vals={ fmt.Sprintf(`{"source": "%s", "category": "", "subcategory": "", "trigger": "category"}`, selectedSource) }
						hx-push-url="true"
						class={ "flex items-center gap-2 text-sm rounded-lg px-2 py-1.5 w-full transition-colors " + categoryItemClass("", selectedCategory) }
					>
						<span class="flex-1">{ T(lang).AllCategories }</span>
					</a>
				</li>
				for _, cat := range categories {
					if cat.Valid {
						<li>
							<a
								href={ templ.SafeURL(fmt.Sprintf("/products?source=%s&category=%s", selectedSource, cat.String)) }
								hx-get="/products"
								hx-target="#product-results"
								hx-vals={ fmt.Sprintf(`{"source": "%s", "category": "%s", "subcategory": "", "trigger": "category"}`, selectedSource, cat.String) }
								hx-push-url="true"
								class={ "flex items-center gap-2 text-sm rounded-lg px-2 py-1.5 w-full transition-colors " + categoryItemClass(cat.String, selectedCategory) }
							>
								<span class="flex-1 leading-tight">{ cat.String }</span>
							</a>
						</li>
					}
				}
			</ul>
		}
	</div>
}

templ SubcategoryFilterOOB(subcategories []sql.NullString, selectedSource string, selectedCategory string, selectedSubcategory string, lang string) {
	<div id="subcategory-filter" class="px-4 py-4" hx-swap-oob="true">
		if selectedCategory != "" && len(subcategories) > 0 {
			<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">{ T(lang).Brand }</h3>
			<ul class="space-y-1 max-h-60 overflow-y-auto">
				<li>
					<a
						href={ templ.SafeURL(fmt.Sprintf("/products?source=%s&category=%s", selectedSource, selectedCategory)) }
						hx-get="/products"
						hx-target="#product-results"
						hx-vals={ fmt.Sprintf(`{"source": "%s", "category": "%s", "subcategory": ""}`, selectedSource, selectedCategory) }
						hx-push-url="true"
						class={ "flex items-center gap-2 text-sm rounded-lg px-2 py-1.5 w-full transition-colors " + categoryItemClass("", selectedSubcategory) }
					>
						<span class="flex-1">{ T(lang).AllCategories }</span>
					</a>
				</li>
				for _, sub := range subcategories {
					if sub.Valid {
						<li>
							<a
								href={ templ.SafeURL(fmt.Sprintf("/products?source=%s&category=%s&subcategory=%s", selectedSource, selectedCategory, sub.String)) }
								hx-get="/products"
								hx-target="#product-results"
								hx-vals={ fmt.Sprintf(`{"source": "%s", "category": "%s", "subcategory": "%s"}`, selectedSource, selectedCategory, sub.String) }
								hx-push-url="true"
								class={ "flex items-center gap-2 text-sm rounded-lg px-2 py-1.5 w-full transition-colors " + categoryItemClass(sub.String, selectedSubcategory) }
							>
								<span class="flex-1 leading-tight">{ sub.String }</span>
							</a>
						</li>
					}
				}
			</ul>
		}
	</div>
}

templ ProductGrid(data ProductsPageData, lang string) {
	if len(data.Products) == 0 {
		<p class="text-gray-500">{ T(lang).NoProducts }</p>
	} else {
		<p class="text-sm text-gray-500 mb-4">{ fmt.Sprintf("%d %s", data.TotalCount, T(lang).ProductsFound) }</p>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
			for _, p := range data.Products {
				@ProductCard(p)
			}
		</div>
		if data.TotalPages > 1 {
			<div class="flex gap-1 mt-8 justify-center items-center flex-wrap">
				if data.Page > 1 {
					<a
						href={ templ.SafeURL(fmt.Sprintf("/products?source=%s&category=%s&subcategory=%s&page=%d",
							data.SelectedSource, data.SelectedCategory, data.SelectedSubcategory, data.Page-1)) }
						class="px-3 py-2 rounded-lg border hover:bg-gray-100 text-sm"
					>←</a>
				}
				for _, p := range paginationPages(data.Page, data.TotalPages) {
					if p == 0 {
						<span class="px-2 py-2 text-sm text-gray-400">...</span>
					} else if p == data.Page {
						<span class="px-3 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold">{ fmt.Sprintf("%d", p) }</span>
					} else {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/products?source=%s&category=%s&page=%d", data.SelectedSource, data.SelectedCategory, p)) }
							class="px-3 py-2 rounded-lg border hover:bg-gray-100 text-sm"
						>{ fmt.Sprintf("%d", p) }</a>
					}
				}
				if data.Page < data.TotalPages {
					<a
						href={ templ.SafeURL(fmt.Sprintf("/products?source=%s&category=%s&page=%d", data.SelectedSource, data.SelectedCategory, data.Page+1)) }
						class="px-3 py-2 rounded-lg border hover:bg-gray-100 text-sm"
					>→</a>
				}
				<span class="w-full text-center text-sm text-gray-500 mt-1">
					{ fmt.Sprintf("%s %d %s %d", T(lang).Page, data.Page, T(lang).Of, data.TotalPages) }
				</span>
			</div>
		}
	}
}

templ ProductCard(p database.GetProductSummariesRow) {
	<a
		href={ templ.SafeURL(fmt.Sprintf("/products/%s", p.ID.String())) }
		class="bg-white rounded-xl shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden flex flex-col group"
	>
		<!-- Image -->
		<div class="aspect-square bg-gray-50 overflow-hidden relative">
			if p.Images.Valid {
				<img
					src={ extractFirstImage(p.Images.RawMessage) }
					alt={ p.Name.String }
					class="w-full h-full object-contain p-4 group-hover:scale-105 transition-transform duration-200"
					loading="lazy"
					onerror="this.style.display='none'"
				/>
			}
			<!-- Discount badge -->
			if p.DiscountPercent.Valid && p.DiscountPercent.Int32 > 0 {
				<span class="absolute top-2 left-2 text-xs bg-red-500 text-white px-2 py-0.5 rounded-full font-semibold">
					-{ fmt.Sprintf("%d%%", p.DiscountPercent.Int32) }
				</span>
			}
			<!-- Stock status -->
			if p.InStock.Valid {
				switch p.InStock.Bool {
					case false:
						<div class="absolute inset-0 bg-white/60 flex items-center justify-center">
							<span class="text-xs font-semibold text-gray-500 bg-white border border-gray-200 px-2 py-1 rounded">Out of stock</span>
						</div>
					case true:
						if p.Quantity.Valid && p.Quantity.Int32 < 5 {
							<div class="absolute bottom-2 left-2">
								<span class="text-xs font-semibold text-orange-500 bg-white border border-orange-200 px-2 py-1 rounded">Low stock</span>
							</div>
						}
				}
			}
		</div>
		<!-- Content -->
		<div class="p-3 flex flex-col flex-1">
			<!-- Brand + Category row -->
			<div class="flex items-center justify-between mb-1">
				switch [2]bool{p.Brand.Valid, p.Category.Valid} {
					case [2]bool{true, true}:
						<span class="text-xs text-blue-600 font-medium uppercase tracking-wide truncate">{ p.Brand.String }</span>
						<span class="text-xs text-gray-400 truncate ml-1">{ p.Category.String }</span>
					case [2]bool{true, false}:
						<span class="text-xs text-blue-600 font-medium uppercase tracking-wide truncate">{ p.Brand.String }</span>
					case [2]bool{false, true}:
						<span class="text-xs text-gray-400 truncate ml-1">{ p.Category.String }</span>
				}
			</div>
			<!-- Name -->
			<h3 class="text-sm font-semibold text-gray-800 line-clamp-2 flex-1 mb-2 leading-snug">
				if p.Name.Valid {
					{ p.Name.String }
				}
			</h3>
			<!-- Rating + reviews -->
			switch [2]bool{p.Rating.Valid, p.ReviewCount.Valid && p.ReviewCount.Int32 > 0} {
				case [2]bool{true, true}:
					<div class="flex items-center gap-1 mb-2">
						<span class="text-yellow-400 text-xs">★</span>
						<span class="text-xs font-medium text-gray-700">{ p.Rating.String }</span>
						<span class="text-xs text-gray-400">({ fmt.Sprintf("%d", p.ReviewCount.Int32) })</span>
					</div>
				case [2]bool{true, false}:
					<div class="flex items-center gap-1 mb-2">
						<span class="text-yellow-400 text-xs">★</span>
						<span class="text-xs font-medium text-gray-700">{ p.Rating.String }</span>
					</div>
			}
			<!-- Price row -->
			<div class="flex items-baseline gap-2 mt-auto">
				switch [2]bool{p.Price.Valid, p.OriginalPrice.Valid && p.OriginalPrice.String != "" && p.OriginalPrice.String != p.Price.String} {
					case [2]bool{true, true}:
						<span class="text-base font-bold text-gray-900">{ formatPrice(p.Price.String, p.Currency.String) }</span>
						<span class="text-xs text-gray-400 line-through">{ formatPrice(p.OriginalPrice.String, p.Currency.String) }</span>
					case [2]bool{true, false}:
						<span class="text-base font-bold text-gray-900">{ formatPrice(p.Price.String, p.Currency.String) }</span>
				}
			</div>
			<!-- Source -->
			if p.Source.Valid {
				<span class="mt-2 text-xs text-gray-400 truncate">{ p.Source.String }</span>
			}
		</div>
	</a>
}

templ SourceFilterOOB(sources []sql.NullString, selectedSource string, lang string) {
	<div id="source-filter" class="px-4 py-4 border-b border-gray-100" hx-swap-oob="true">
		<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">{ T(lang).Source }</h3>
		<ul class="space-y-1">
			<li>
				<a
					href="/products"
					hx-get="/products"
					hx-target="#product-results"
					hx-vals='{"source": "", "category": "", "subcategory": "", "trigger": "source"}'
					hx-push-url="true"
					class={ "flex items-center gap-2 text-sm rounded-lg px-2 py-1.5 w-full transition-colors " + sourceItemClass("", selectedSource) }
				>
					<span class="flex-1">{ T(lang).AllSources }</span>
				</a>
			</li>
			for _, s := range sources {
				if s.Valid {
					<li>
						<a
							href={ templ.SafeURL(fmt.Sprintf("/products?source=%s", s.String)) }
							hx-get="/products"
							hx-target="#product-results"
							hx-vals={ fmt.Sprintf(`{"source": "%s", "category": "", "subcategory": "", "trigger": "source"}`, s.String) }
							hx-push-url="true"
							class={ "flex items-center gap-2 text-sm rounded-lg px-2 py-1.5 w-full transition-colors " + sourceItemClass(s.String, selectedSource) }
						>
							<span class="flex-1">{ s.String }</span>
						</a>
					</li>
				}
			}
		</ul>
	</div>
}

templ ActiveChipsOOB(data ProductsPageData, lang string) {
	<div id="active-chips" hx-swap-oob="true">
		if data.SelectedSource != "" || data.SelectedCategory != "" || data.SelectedSubcategory != "" {
			<div class="flex flex-wrap gap-2 mb-4">
				if data.SelectedSource != "" {
					<span class="inline-flex items-center gap-1 text-xs bg-blue-100 text-blue-700 rounded-full px-3 py-1 font-medium">
						{ data.SelectedSource }
						<a
							href={ templ.SafeURL(fmt.Sprintf("/products?category=%s&subcategory=%s", data.SelectedCategory, data.SelectedSubcategory)) }
							class="hover:text-blue-900 ml-1"
						>✕</a>
					</span>
				}
				if data.SelectedCategory != "" {
					<span class="inline-flex items-center gap-1 text-xs bg-blue-100 text-blue-700 rounded-full px-3 py-1 font-medium">
						{ data.SelectedCategory }
						<a
							href={ templ.SafeURL(fmt.Sprintf("/products?source=%s&subcategory=%s", data.SelectedSource, data.SelectedSubcategory)) }
							class="hover:text-blue-900 ml-1"
						>✕</a>
					</span>
				}
				if data.SelectedSubcategory != "" {
					<span class="inline-flex items-center gap-1 text-xs bg-blue-100 text-blue-700 rounded-full px-3 py-1 font-medium">
						{ data.SelectedSubcategory }
						<a
							href={ templ.SafeURL(fmt.Sprintf("/products?source=%s&category=%s", data.SelectedSource, data.SelectedCategory)) }
							class="hover:text-blue-900 ml-1"
						>✕</a>
					</span>
				}
				<a
					href="/products"
					class="text-xs text-gray-500 hover:text-gray-700 underline self-center"
				>
					{ T(lang).ClearAll }
				</a>
			</div>
		}
	</div>
}
