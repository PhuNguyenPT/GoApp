{
  "name": "frontend-template",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm run minify:css && npm run lint && npm run minify:js",
    "minify:css": "npx tailwindcss -i ./public/styles/index.css -o ./public/output.css --minify",
    "minify:js": "for f in public/scripts/*.js; do npx terser $f -o public/$(basename $f .js).min.js --compress --mangle; done",
    "lint": "eslint public/scripts/**/*.js",
    "lint:fix": "eslint public/scripts/**/*.js --fix",
    "fmt": "prettier --write public/scripts/**/*.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.2",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "terser": "^5.46.0"
  }
}
